        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "instructions": {
            "type": "string",
            "title": "Instructions"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "instructions",
          "created_at"
        ],
        "title": "ConversationDTO"
      },
      "CreateMessageRequest": {
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Project Id"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Conversation Id"
          },
          "content": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Content"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "project_id",
          "conversation_id",
          "content",
          "request_id"
        ],
        "title": "CreateMessageRequest"
      },
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Name"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "request_id"
        ],
        "title": "CreateProjectRequest"
      },
      "ErrorDTO": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDTO"
      },
      "ErrorResponseDTO": {
