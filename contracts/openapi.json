            "minLength": 3,
            "pattern": "^[^\\x00]*$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\x00]*$",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
