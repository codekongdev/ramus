          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "author_id",
          "author_name",
          "role",
          "content",
          "sequence",
          "created_at"
        ],
        "title": "MessageDTO"
      },
      "MessagePostDTO": {
        "properties": {
          "message": {
            "$ref": "#/components/schemas/MessageDTO"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessagePostDTO"
      },
      "OkDTO": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "OkDTO"
      },
      "ProjectDTO": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "instructions": {
            "type": "string",
            "title": "Instructions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "instructions"
        ],
        "title": "ProjectDTO"
      },
      "StateDTO": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDTO"
          },
          "project": {
            "$ref": "#/components/schemas/ProjectDTO"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/UserDTO"
            },
            "type": "array",
            "title": "Members"
          },
          "conversations": {
            "items": {
              "$ref": "#/components/schemas/ConversationDTO"
            },
            "type": "array",
            "title": "Conversations"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageDTO"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user",
          "project",
          "members",
          "conversations",
          "messages"
        ],
        "title": "StateDTO"
      },
      "UserDTO": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "title": "UserDTO"
      }
