{
  "name": "ramus",
  "private": true,
  "scripts": {
    "api:openapi": "uv run --project apps/api python apps/api/scripts/export_openapi.py",
    "gen:api": "pnpm api:openapi && pnpm --filter @ramus/web gen:api",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "verify": "node scripts/verify/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "packageManager": "pnpm@11.3.0"
}
