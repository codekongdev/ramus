OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
RAMUS_BUDGET_USD=50
DATABASE_URL=postgresql+psycopg://ramus:ramus-local@127.0.0.1:55432/ramus
RAMUS_WEB_PORT=5173
RAMUS_API_PORT=8000
RAMUS_COOKIE_SECURE=false
RAMUS_AUTH_SECRET=
# Development logs codes; staging/production require smtp and a stable RAMUS_AUTH_SECRET.
RAMUS_ENV=development
RAMUS_MAILER=logging
# Set the host and verified sender supplied by your mail provider. No plaintext SMTP mode.
RAMUS_SMTP_HOST=
RAMUS_SMTP_PORT=587
RAMUS_SMTP_SECURITY=starttls
RAMUS_SMTP_FROM=
RAMUS_SMTP_USERNAME=
RAMUS_SMTP_PASSWORD=
RAMUS_SMTP_TIMEOUT=10
# Base64url-encoded 32 random bytes; required to connect or decrypt personal AI keys.
RAMUS_SECRET_KEY=

# Optional legacy email-code login. Password signup/login requires no SMTP.
RAMUS_EMAIL_CODE_AUTH_ENABLED=false
